@@ -0,0 +1,74 @@
+// CoEvo's real local integration for momo-code's existing Pi dependency.
+import { readFileSync, writeFileSync, mkdirSync, realpathSync, appendFileSync } from "node:fs";
+import { resolve, basename, dirname } from "node:path";
+import {
+  createAgentSession, createExtensionRuntime, ModelRuntime, SessionManager, SettingsManager,
+  createReadToolDefinition, createWriteToolDefinition,
+} from "@earendil-works/pi-coding-agent";
+
+const request = JSON.parse(readFileSync(process.env.COEVO_REQUEST_FILE, "utf8"));
+const cwd = realpathSync(request.workspace);
+const runDir = resolve(request.run_dir);
+mkdirSync(runDir, { recursive: true });
+const agentDir = resolve(runDir, "agent-state");
+mkdirSync(agentDir, { recursive: true });
+const authPath = resolve(agentDir, "auth.json");
+writeFileSync(authPath, "{}\n");
+const runtime = await ModelRuntime.create({ authPath, modelsPath: null, refreshOnCreate: false, allowModelNetwork: false });
+runtime.registerProvider("coevo-local", {
+  api: "openai-completions", baseUrl: request.endpoint, apiKey: "local-no-secret",
+  models: [{ id: request.model, name: request.model, input: ["text"], reasoning: false,
+    contextWindow: request.context_tokens ?? 139264, maxTokens: 1024,
+    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+    compat: { supportsDeveloperRole: false },
+  }],
+});
+const model = runtime.getModel("coevo-local", request.model);
+if (!model) throw new Error("Local model registration failed");
+function allowed(path, name) {
+  const absolute = resolve(cwd, path);
+  if (absolute !== resolve(cwd, name)) throw new Error(`Unauthorized task path: ${basename(path)}`);
+  return absolute;
+}
+// Reuse Pi's actual tools, restricting this pilot to task-authorized files.
+const read = createReadToolDefinition(cwd, { operations: {
+  access: async (path) => { allowed(path, "input.json"); },
+  readFile: async (path) => readFileSync(allowed(path, "input.json")),
+}});
+const write = createWriteToolDefinition(cwd, { operations: {
+  mkdir: async (path) => { if (resolve(path) !== cwd) throw new Error("Unauthorized directory"); },
+  writeFile: async (path, content) => { writeFileSync(allowed(path, "output.json"), content); },
+}});
+const systemPrompt = request.system_prompt ?? "You are a local coding agent. Read task input and use actual tools to produce the requested file. Do not claim completion without writing it. Only input.json and output.json are authorized.";
+const loader = {
+  getExtensions: () => ({ extensions: [], errors: [], runtime: createExtensionRuntime() }),
+  getSkills: () => ({ skills: [], diagnostics: [] }), getPrompts: () => ({ prompts: [], diagnostics: [] }),
+  getThemes: () => ({ themes: [], diagnostics: [] }), getAgentsFiles: () => ({ agentsFiles: [] }),
