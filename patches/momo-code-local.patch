diff --git a/packages/opencode/bin/momo b/packages/opencode/bin/momo
index 0961085..9c5edcc 100644
--- a/packages/opencode/bin/momo
+++ b/packages/opencode/bin/momo
@@ -147,6 +147,20 @@ function showVersion() {
 }
 
 // ── Main ──────────────────────────────────────────────────────────
+// CoEvo routes its authorized task request to a real SDK session; no simulated REPL fallback.
+if (process.env.COEVO_CONTROL_REQUEST) {
+  const action = process.argv[2];
+  if (!["train", "evaluate", "status"].includes(action)) throw new Error("Use momo train|evaluate|status with COEVO_CONTROL_REQUEST");
+  if (!process.env.COEVO_PROJECT_ROOT || !process.env.COEVO_PYTHON) throw new Error("Specify CoEvo project and local environment");
+  const child = spawn(process.env.COEVO_PYTHON, ["-m", "coevo.bridge", action, "--request", process.env.COEVO_CONTROL_REQUEST],
+    { cwd: process.env.COEVO_PROJECT_ROOT, stdio: "inherit", env: process.env });
+  child.on("exit", (code) => process.exit(code ?? 1));
+  child.on("error", (error) => { console.error(error.message); process.exit(1); });
+} else if (process.env.COEVO_REQUEST_FILE) {
+  const child = spawn(process.execPath, [join(__dirname, "../scripts/coevo-agent.mjs")], { stdio: "inherit", env: process.env });
+  child.on("exit", (code) => process.exit(code ?? 1));
+  child.on("error", (error) => { console.error(error.message); process.exit(1); });
+} else {
 const argv = process.argv.slice(2)
 
 if (["version", "--version", "-v"].includes(argv[0])) {
@@ -169,3 +183,5 @@ if (args.mode === "legacy") {
     process.exit(1)
   })
 }
+
+}
